# Copy to api/.env and fill in. Nothing here is required to RUN the system —
# without it you get the scripted agent and a local SQLite file.

# --- Agent -----------------------------------------------------------------
# scripted = deterministic, no network, no cost (default)
# grok     = xAI Grok with JSON-schema structured outputs
AGENT_MODE=scripted

# Required only when AGENT_MODE=grok. Get one at https://console.x.ai
XAI_API_KEY=

# Optional overrides
# XAI_MODEL=grok-4.5
# XAI_CLASSIFIER_MODEL=grok-4.1-fast
# XAI_BASE_URL=https://api.x.ai/v1

# --- Persistence -----------------------------------------------------------
# Supabase: Project Settings -> Database -> Connection string -> URI.
# Use the SESSION POOLER host, not the direct one (direct is IPv6-only on the
# free tier and often unreachable from home networks).
# Leave blank to fall back to api/.local/fallback.db (SQLite).
DATABASE_URL=

# --- Temporal --------------------------------------------------------------
TEMPORAL_ADDRESS=localhost:7233
